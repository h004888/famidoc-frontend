# Port cho Frontend Server (Dokploy port mapping: 3000)
PORT=3000

# URL gọi nội bộ Docker Network đến service famidoc-backend (Dùng cho Server-Side Rendering / Server Actions)
INTERNAL_BACKEND_URL=http://famidoc-backend:4000

# URL gọi công khai từ trình duyệt Client (Điền domain thực tế của backend trên Dokploy)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
